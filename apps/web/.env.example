# apps/web environment (Vercel). Parsed once by src/server/env.ts (the only reader).
# Never commit real values. Mark secrets as "Sensitive" in Vercel.

# Public base URL of this deployment: https, no trailing slash. Meta webhook URL and MCP URL derive from it.
PUBLIC_BASE_URL=

# Supabase project (URL + anon key are public; service role key is server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared with the Supabase Edge Functions (cloud-retry, deliver-webhooks): header x-internal-secret. >= 32 chars.
INTERNAL_API_SECRET=

# Comma-separated Grok Bot webhook host names for relay targets (exact or *.suffix). Empty = nothing allowed.
RELAY_ALLOWED_HOSTS=
# Optional: hosts for generic outbound webhooks (defaults to RELAY_ALLOWED_HOSTS).
WEBHOOK_ALLOWED_HOSTS=

# Optional: comma-separated phone numbers that seed the Lia sender allowlist (personal numbers come only from env).
LIA_ALLOWLIST_SEED=

# Optional: Cloudflare Turnstile secret for the login form.
TURNSTILE_SECRET=
